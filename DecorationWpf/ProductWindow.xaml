<Window x:Class="DecorationWpf.ProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DecorationWpf"
        Title="Список товаров" Height="700" Width="950"
        FontFamily="{StaticResource Comic}"
        Icon="pack://application:,,,/Images/icon.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="150" />
            <RowDefinition Height="80" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="{StaticResource Dopol}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="30" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Image Source="pack://application:,,,/Images/logo.png" Grid.Column="0" Grid.RowSpan="2"/>
            <TextBlock Text="Список товаров" Grid.Column="1" TextAlignment="Center" VerticalAlignment="Center" FontSize="24" Grid.RowSpan="2"/>
            <TextBlock x:Name="txtUserFio" Text="Пользователь" VerticalAlignment="Center" Margin="0,0,15,0" FontWeight="Bold" Grid.Column="2" Grid.Row="0"/>
            <WrapPanel Orientation="Vertical" Grid.Column="2" VerticalAlignment="Center" Margin="0,0,20,0" Grid.Row="1">
                <Button x:Name="btnAddProduct" Content="Добавить товар" Visibility="Collapsed" Click="BtnAddProduct_Click" Background="{StaticResource Accent}" Foreground="White" Padding="10,5" Margin="0,0,5,5"/>
                <Button x:Name="btnEditProduct" Content="Редактировать" Visibility="Collapsed" Click="BtnEditProduct_Click" Background="{StaticResource Accent}" Foreground="White" Padding="10,5" Margin="0,0,5,5"/>
                <Button x:Name="btnDeleteProduct" Content="Удалить" Visibility="Collapsed" Click="BtnDeleteProduct_Click" Background="{StaticResource Accent}" Foreground="White" Padding="10,5" Margin="0,0,5,5"/>
                <Button x:Name="btnOrders" Content="ЗАКАЗЫ" Visibility="Collapsed" Click="BtnOrders_Click" Background="{StaticResource Accent}" Foreground="White" Padding="10,5" Margin="0,0,5,5"/>
                <Button x:Name="btnViewOrder" Content="Посмотреть заказ" Visibility="Collapsed" Click="BtnViewOrder_Click" Background="{StaticResource Accent}" Foreground="White" Padding="10,5" Margin="0,0,5,0"/>
                <Button x:Name="btnLogout" Content="Выход" Click="BtnLogout_Click" Background="{StaticResource Accent}" Foreground="White" Padding="10,5"/>
            </WrapPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="180" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="txtQuantity" Text="0 из 0" Grid.Column="0" VerticalAlignment="Center" FontWeight="Bold"/>
            <TextBox x:Name="tbSearch" Grid.Column="1" Height="30" VerticalContentAlignment="Center" TextChanged="TbSearch_TextChanged" Margin="10,0,10,0"/>
            <ComboBox x:Name="cbPrice" Grid.Column="2" Height="30" SelectionChanged="CbPrice_SelectionChanged" Margin="0,0,10,0"/>
            <ComboBox x:Name="cbDiscount" Grid.Column="3" Height="30" SelectionChanged="CbDiscount_SelectionChanged"/>
        </Grid>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock x:Name="txtNotFound" Visibility="Collapsed" FontWeight="Medium" FontSize="20" Text="Ничего не найдено" HorizontalAlignment="Center" Margin="20"/>
                <ItemsControl x:Name="icProducts">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Height="150" CornerRadius="5" BorderThickness="1" BorderBrush="Black" Margin="5" Background="{Binding DiscountBackground}" MouseLeftButtonDown="Product_Click">
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Добавить к заказу" Click="AddToOrder_Click"/>
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <Grid Margin="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="150"/>
                                    </Grid.ColumnDefinitions>

                                    <Image Source="{Binding ProductPhoto, Converter={StaticResource ImgConverter}}" Margin="5" Stretch="Uniform"/>
                                    <StackPanel VerticalAlignment="Center" Grid.Column="1" Margin="10,0,0,0">
                                        <TextBlock FontSize="14" FontWeight="Medium" Text="{Binding ProductName}"/>
                                        <TextBlock Text="{Binding ProductDescription}"/>
                                        <TextBlock Text="{Binding ProductManufacturer}" />
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding ProductPrice}" TextDecorations="{Binding ProductPriceStrike}"/>
                                            <TextBlock Margin="5 0 0 0" Text="{Binding FinalProductPrice}"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Grid.Column="2">
                                        <TextBlock Margin="0 0 0 10" Text="Размер скидки"/>
                                        <TextBlock Text="{Binding ProductDiscount}"/>
                                        <TextBlock Text="{Binding Кол_во_на_складе, StringFormat='На складе: {0}'}" Margin="0,10,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>