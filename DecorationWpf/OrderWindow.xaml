<Window x:Class="DecorationWpf.OrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DecorationWpf"
        Title="Просмотр заказа" Height="500" Width="700" WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource Comic}" ResizeMode="NoResize">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Клиент: " FontWeight="Bold"/>
            <TextBlock x:Name="txtClientFio" Text="Гость" Margin="5,0,0,0"/>
        </StackPanel>

        <ListView x:Name="lvOrderItems" Grid.Row="1" Margin="0,0,0,10">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Товар" DisplayMemberBinding="{Binding ProductName}" Width="200"/>
                    <GridViewColumn Header="Цена" DisplayMemberBinding="{Binding ProductPrice}" Width="100"/>
                    <GridViewColumn Header="Кол-во" Width="100">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Width="50" TextChanged="Quantity_TextChanged"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Сумма" DisplayMemberBinding="{Binding TotalPrice}" Width="100"/>
                    <GridViewColumn Header="Действие" Width="100">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Удалить" Click="RemoveItem_Click" Background="{StaticResource Accent}" Foreground="White"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <StackPanel Grid.Row="2" Margin="0,0,0,10">
            <TextBlock Text="Пункт выдачи:" FontWeight="Bold" Margin="0,0,0,5"/>
            <ComboBox x:Name="cbPickupPoints" DisplayMemberPath="FullAddress" Height="30"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <TextBlock x:Name="txtTotalSum" Text="Итого: 0 руб." FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,20,0"/>
            <Button Content="Оформить заказ" Click="CompleteOrder_Click" Background="{StaticResource Accent}" Foreground="White" Padding="15,5" Margin="0,0,10,0"/>
            <Button Content="Закрыть" Click="Close_Click" Padding="15,5"/>
        </StackPanel>
    </Grid>
</Window>