<Window x:Class="DecorationWpf.OrderManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DecorationWpf"
        Title="Работа с заказами" Height="600" Width="1000" MinHeight="400" MinWidth="800"
        FontFamily="{StaticResource Comic}"
        Icon="pack://application:,,,/Images/icon.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="150" />
            <RowDefinition Height="80" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="{StaticResource Dopol}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Image Source="pack://application:,,,/Images/logo.png" Grid.Column="0" Margin="10"/>
            <TextBlock Text="Работа с заказами" Grid.Column="1" TextAlignment="Center" VerticalAlignment="Center" FontSize="24"/>
            <StackPanel Orientation="Vertical" Grid.Column="2" VerticalAlignment="Center" Margin="0,0,20,0">
                <Button Content="ТОВАРЫ" Click="BtnBack_Click" Background="{StaticResource Accent}" Foreground="White" Padding="10,5" Margin="0,0,5,0"/>
                <Button Content="Выход" Click="BtnLogout_Click" Background="{StaticResource Accent}" Foreground="White" Padding="10,5" Margin="0,5,0,0"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="160" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="Сортировка" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0"/>
            <ComboBox x:Name="cbSort" Grid.Column="1" Width="150" Height="30" SelectionChanged="CbSort_SelectionChanged"/>

            <TextBlock Text="Размер скидки" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0"/>
            <ComboBox x:Name="cbDiscount" Grid.Column="3" Width="150" Height="30" SelectionChanged="CbDiscount_SelectionChanged"/>
        </Grid>

        <DataGrid x:Name="dgOrders" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="False" Margin="10" CanUserAddRows="False">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Background" Value="{Binding RowBackground}"/>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Номер" Binding="{Binding id_заказа}" Width="70" IsReadOnly="True"/>
                <DataGridTextColumn Header="Дата заказа" Binding="{Binding Дата_заказа, StringFormat={}{0:dd.MM.yyyy}}" Width="100" IsReadOnly="True"/>
                <DataGridTextColumn Header="Дата доставки" Width="100"
                            Binding="{Binding Дата_доставки, StringFormat={}{0:dd.MM.yyyy}, UpdateSourceTrigger=PropertyChanged}"/>
                <DataGridTextColumn Header="Сумма" Binding="{Binding TotalSum, StringFormat={}{0:N2} руб.}" Width="100" IsReadOnly="True"/>
                <DataGridTextColumn Header="Скидка" Binding="{Binding TotalDiscount, StringFormat={}{0:N2}%}" Width="80" IsReadOnly="True"/>
                <DataGridTextColumn Header="Клиент" Binding="{Binding ClientFio}" Width="150" IsReadOnly="True"/>
                <DataGridTextColumn Header="Пункт выдачи" Binding="{Binding PickupAddress}" Width="200" IsReadOnly="True"/>
                <DataGridTextColumn Header="Код" Binding="{Binding Код_для_получения}" Width="70" IsReadOnly="True"/>
                <DataGridComboBoxColumn Header="Статус" x:Name="colStatus" Width="100"
                                SelectedValueBinding="{Binding Status, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>